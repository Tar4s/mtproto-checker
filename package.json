{
  "name": "mtproto-checker",
  "version": "0.6.0",
  "description": "Check Telegram MTProto proxies via a real TDLib handshake (testProxy), like tdesktop does",
  "main": "check.js",
  "exports": {
    ".": "./check.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tar4s/mtproto-checker.git"
  },
  "bugs": {
    "url": "https://github.com/Tar4s/mtproto-checker/issues"
  },
  "homepage": "https://github.com/Tar4s/mtproto-checker#readme",
  "bin": {
    "mtproto-checker": "check.js"
  },
  "files": [
    "check.js",
    "pool.js",
    "web/index.html",
    "README.md",
    "urls.txt"
  ],
  "scripts": {
    "start": "node check.js",
    "serve": "node check.js serve",
    "pool": "node check.js pool",
    "dev:pool": "node --env-file=.env check.js pool --sources sources.txt --iterations 5 --interval 4 --concurrency 20"
  },
  "license": "Unlicense",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "tdl": "^8.0.2",
    "prebuilt-tdlib": "0.1008064.0"
  }
}
